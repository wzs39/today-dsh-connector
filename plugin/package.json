{
  "name": "@local/dsh-today-connector",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "把 Today（api.todayai.cn）注册成 DeepSeek Harness 模型提供方：Cookie 自动续期 JWT、单会话串行、429 不重试、如实标注无原生工具调用与真流式。",
  "exports": {
    ".": "./lib/index.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "lib",
    "locale/*.json",
    "cordis.patch.yml",
    "icon.svg",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=4.0.1",
    "@deepseek-ai/dsh-llm": "*",
    "@deepseek-ai/schemastery": ">=3.18.1"
  }
}
